# Copiar a .env.local (ignorado por git) para trabajar contra el BFF real con `npm run dev`.
# `false`: sin mocks, las peticiones van al BFF. `npm run dev:mock` carga .env.mock y los vuelve a encender.
VITE_USE_MOCKS=false
# URL del BFF al que apunta el proxy de `npm run dev` (por defecto, el compose de solventa-backend).
VITE_BFF_URL=http://localhost:8000
