# Copiar a .env.local (ignorado por git) para trabajar contra el backend real con `npm run dev`.
# `false`: sin mocks, las peticiones van al gateway/BFF. `npm run dev:mock` carga .env.mock y los vuelve a encender.
VITE_USE_MOCKS=false
# URL del API Gateway Envoy local del compose de solventa-backend (`:8080`, corta a 700 ms).
# Para depurar directo contra el BFF sin pasar por el gateway, usar http://localhost:8000.
VITE_BFF_URL=http://localhost:8080
# Dummy de siniestros (HU-W04) de solventa-backend: `docker compose --profile servicios up stub-siniestros`.
# Público y sin token; el proxy de Vite le manda /graphql/siniestros (también en `dev:mock`).
VITE_SINIESTROS_URL=http://localhost:8105
